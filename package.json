{
  "name": "family-office-ai-workflow",
  "version": "1.0.0",
  "description": "Family office AI workflow system with TypeScript implementation",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist/",
    "start": "npm run build && node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:fix": "eslint src/**/*.ts src/**/*.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "openbanking-fetcher": "./dist/openbanking-fetcher.js",
    "analyze-orchestrator": "./dist/analyze-orchestrator.js",
    "portfolio-orchestrator": "./dist/portfolio-orchestrator.js",
    "portfolio-cli": "./dist/cli.js",
    "dashboard": "./dist/dashboard.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.4",
    "ink": "^8.0.0",
    "open": "^11.0.4",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "family-office",
    "portfolio-management",
    "powens-api",
    "financial-analysis",
    "typescript"
  ],
  "author": "Family Office AI Workflow",
  "license": "UNLICENSED",
  "private": true
}
